# Hostens (Apache/LiteSpeed). Copied into dist/ by Vite because it lives in public/.

<IfModule mod_headers.c>
  # Vite's hashed build files (dist/assets/<name>-<hash>.js|css|otf) never change: cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images, fonts and the Godot export: a week.
  <FilesMatch "\.(webp|png|jpe?g|svg|otf|woff2?|wasm|pck)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML and the résumé must always be revalidated so updates show up.
  <FilesMatch "\.(html|pdf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm
</IfModule>
